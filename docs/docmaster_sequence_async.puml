@startuml
skinparam maxMessageSize 150
skinparam ParticipantPadding 20
skinparam BoxPadding 10

actor "Utilisateur" as User
participant "Frontend\n(React)" as Front
participant "Backend\n(Express)" as API
database "PostgreSQL" as DB
queue "Bull Queue\n(Redis)" as Redis
participant "Bull Worker\n(Node.js)" as Worker

' --- 1. UPLOAD ---
User -> Front : Glisse un fichier
Front -> Front : Valide MIME & taille (côté client)
Front -> API : POST /api/files/upload (fichier)
activate API
API -> API : Vérifie token JWT\nValide fichier (Multer)\nSauvegarde sur disque
API -> DB : INSERT INTO files (metadata)
DB --> API : OK (id_files)
API --> Front : Réponse (id_files)
deactivate API

' --- 2. LANCEMENT DU JOB ---
User -> Front : Clique sur "Traiter" (ex: Compresser)
Front -> API : POST /api/jobs (type_operation, fichiers: [id_files])
activate API
API -> DB : INSERT INTO jobs (statut='pending')
DB --> API : OK (id_jobs)
API -> Redis : Ajoute le job dans la file d'attente
API --> Front : { id_jobs, statut: 'pending' }
deactivate API

' --- 3. TRAITEMENT ASYNCHRONE & POLLING ---
group Polling [Toutes les 2 secondes]
    Front -> API : GET /api/jobs/:id
    activate API
    API -> DB : SELECT statut, progression FROM jobs
    DB --> API : statut (pending / processing / done / error)
    API --> Front : Réponse (statut, progression)
    deactivate API
end

' Le worker tourne en parallèle du polling
note right of Redis
  Le Worker tourne en 
  arrière-plan indépendamment
end note

Redis <- Worker : Récupère job (statut pending)
activate Worker
Worker -> DB : UPDATE jobs SET statut='processing'
Worker -> Worker : Exécute opération PDF\n(Ghostscript, pdf-lib...)

alt Opération réussie
    Worker -> DB : UPDATE jobs SET statut='done', resultat_url='...'
    DB --> Worker : OK
else Échec
    Worker -> DB : UPDATE jobs SET statut='error', erreur_message='...'
    DB --> Worker : OK
end
deactivate Worker

' --- 4. TÉLÉCHARGEMENT ---
Front -> Front : Reçoit statut='done'\nAffiche bouton "Télécharger"
User -> Front : Clique sur "Télécharger"
Front -> API : GET /api/files/download/:result_file_id
activate API
API -> API : Vérifie token JWT & Droits (owner_id)
API --> Front : Retourne le flux du fichier (Stream)
deactivate API
Front --> User : Téléchargement du fichier
@enduml
