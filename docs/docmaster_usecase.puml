@startuml
left to right direction
skinparam packageStyle rectangle

actor "Visiteur" as Visiteur
actor "Utilisateur Connecté" as User
actor "Administrateur" as Admin
actor "Système (Worker/Cron)" as System

Visiteur <|-- User
User <|-- Admin

rectangle "Plateforme DocMaster" {
  
  ' --- Cas d'utilisation Visiteur ---
  usecase "S'inscrire" as UC_Inscrire
  usecase "Se connecter" as UC_Connecter
  
  ' --- Cas d'utilisation Utilisateur Connecté ---
  usecase "Consulter son tableau de bord" as UC_Dashboard
  usecase "Gérer son profil" as UC_Profil
  usecase "Uploader un fichier PDF" as UC_Upload
  usecase "Gérer ses fichiers (Télécharger/Supprimer)" as UC_Files
  
  usecase "Utiliser l'Atelier PDF" as UC_Atelier
  usecase "Signer un PDF (Signature Simple)" as UC_Signer
  usecase "Fusionner, Convertir, Compresser..." as UC_Tools
  
  usecase "Suivre la progression d'un Job" as UC_Jobs
  usecase "Consulter son abonnement" as UC_Abo_User
  usecase "Souscrire à un plan Pro (PayDunya)" as UC_Souscrire
  usecase "Se déconnecter" as UC_Logout
  
  ' --- Cas d'utilisation Administrateur ---
  usecase "Gérer les utilisateurs (Désactiver/Réactiver)" as UC_Admin_Users
  usecase "Consulter le journal d'audit (Actions)" as UC_Admin_Audit
  usecase "Voir l'historique global des Jobs" as UC_Admin_Jobs
  usecase "Consulter les statistiques globales" as UC_Admin_Stats
  usecase "Superviser les abonnements" as UC_Admin_Abos
  
  ' --- Cas d'utilisation Système ---
  usecase "Traiter les jobs en file d'attente (Redis)" as UC_Sys_Jobs
  usecase "Mettre à jour les statuts d'abonnements expirés" as UC_Sys_Expire
}

' Relations Visiteur
Visiteur --> UC_Inscrire
Visiteur --> UC_Connecter

' Relations Utilisateur Connecté
User --> UC_Dashboard
User --> UC_Profil
User --> UC_Upload
User --> UC_Files
User --> UC_Atelier
User --> UC_Jobs
User --> UC_Abo_User
User --> UC_Logout

' Inclusions et Extensions de l'Utilisateur
UC_Atelier <.. UC_Upload : <<include>>
UC_Atelier <.. UC_Signer : <<extend>>
UC_Atelier <.. UC_Tools : <<extend>>
UC_Abo_User <.. UC_Souscrire : <<extend>>

' Relations Administrateur
Admin --> UC_Admin_Users
Admin --> UC_Admin_Audit
Admin --> UC_Admin_Jobs
Admin --> UC_Admin_Stats
Admin --> UC_Admin_Abos

' Relations Système
System --> UC_Sys_Jobs
System --> UC_Sys_Expire

@enduml
